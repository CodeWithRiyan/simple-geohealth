{
    "name": "simple-geohealth",
    "version": "0.1.0",
    "description": "Health facilities near you, on a map, from open data",
    "private": true,
    "license": "MIT",
    "packageManager": "pnpm@10.34.5",
    "engines": {
        "node": ">=22.19.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "e2e": "playwright test",
        "size": "vite build && size-limit",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint": "eslint .",
        "format": "prettier --write .",
        "boundaries:build": "tsx scripts/boundaries/build.ts"
    },
    "dependencies": {
        "@emotion/react": "^11.8.1",
        "@emotion/styled": "^11.8.1",
        "@mui/material": "^5.4.3",
        "maplibre-gl": "^6.14.0",
        "react": "^17.0.2",
        "react-dom": "^17.0.2"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^10.0.0",
        "@playwright/test": "~1.58.2",
        "@size-limit/file": "^14.1.0",
        "@testing-library/jest-dom": "^6.6.0",
        "@testing-library/react": "^12.1.5",
        "@testing-library/user-event": "^14.5.0",
        "@turf/simplify": "^7.4.0",
        "@types/geojson": "7946.0.16",
        "@types/node": "^22.0.0",
        "@types/react": "^17.0.20",
        "@types/react-dom": "^17.0.9",
        "@vitejs/plugin-react": "^6.0.0",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10.0.0",
        "eslint-plugin-react-hooks": "^7.0.0",
        "eslint-plugin-react-refresh": "^0.5.0",
        "globals": "^16.0.0",
        "jsdom": "^30.0.0",
        "prettier": "^3.0.0",
        "size-limit": "^14.1.0",
        "tsx": "^4.23.15",
        "typescript": "~5.9.0",
        "typescript-eslint": "^8.40.0",
        "vite": "^8.0.0",
        "vitest": "^5.0.0"
    }
}
